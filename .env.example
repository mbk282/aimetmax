# Kopieer dit bestand naar .env.local en vul de echte waarde in.
# .env.local staat in .gitignore en wordt NOOIT gecommit.
#
# Gemini API-key voor server-side LLM-tools (bijv. de vibe-code tool).
# Haal een sleutel op via Google AI Studio (https://aistudio.google.com/apikey).
# Sinds 2026 geeft Google AI Studio alleen nog "AQ"-keys uit (de oude "AIza"-keys worden
# uitgefaseerd: geweigerd vanaf sep 2026). Een sleutel die met "AQ." begint is dus correct.
# Zet dezelfde variabele ook in Vercel: Project > Settings > Environment Variables.
GEMINI_API_KEY=

# Stripe Checkout voor de pre-order van de AI-gesprekskaarten.
# Zet deze ook in Vercel als Environment Variable en redeploy.
STRIPE_SECRET_KEY=
