# Kopieer dit bestand naar .env.local en vul de echte waarde in.
# .env.local staat in .gitignore en wordt NOOIT gecommit.
#
# Gemini API-key voor server-side LLM-tools (bijv. de vibe-code tool).
# Haal een sleutel op via Google AI Studio (https://aistudio.google.com/apikey).
# Sinds 2026 geeft Google AI Studio alleen nog "AQ"-keys uit (de oude "AIza"-keys worden
# uitgefaseerd: geweigerd vanaf sep 2026). Een sleutel die met "AQ." begint is dus correct.
# Zet dezelfde variabele ook in Vercel: Project > Settings > Environment Variables.
GEMINI_API_KEY=

# Stripe Checkout voor de bestelpagina van de AI-gesprekskaarten.
# Zet deze ook in Vercel als Environment Variable en redeploy.
STRIPE_SECRET_KEY=

# Stripe-webhook (Developers > Webhooks > endpoint toevoegen op
# https://aimetmax.nl/api/kaarten-checkout/webhook, event
# checkout.session.completed). Zonder deze wordt de voorraadteller nooit
# verlaagd, ook niet als STRIPE_SECRET_KEY wel is gezet.
STRIPE_WEBHOOK_SECRET=

# Live voorraadteller voor de kaarten (Upstash Redis via Vercel Marketplace:
# Vercel-project > Storage > Marketplace Database Providers > Upstash >
# Redis). Zet de REST-URL en -token die Upstash geeft onder precies deze
# namen. Zonder deze env-vars toont de bestelpagina geen voorraad en geldt
# gewoon het statische maxOnlineAantal uit bestel-config.ts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Zelfgekozen wachtwoord om de voorraadteller handmatig te zetten via
# POST /api/kaarten-voorraad (bijv. na een bestelling op factuur, of om de
# teller voor het eerst te initialiseren). Verzin zelf een lange, willekeurige
# waarde.
VOORRAAD_ADMIN_TOKEN=
